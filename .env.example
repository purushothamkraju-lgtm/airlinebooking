# Copy this file to .env and fill in your Neon connection string.
# Get it from the Neon console (console.neon.tech) -> your project ->
# Connect -> "Connection string" (the pooled one, with -pooler in the host,
# is recommended). It already includes sslmode=require.
DATABASE_URL=postgresql://user:password@ep-example-12345.region.aws.neon.tech/neondb?sslmode=require

# Optional — port the server listens on (defaults to 3001).
# PORT=3001

# Required for Better Auth (user accounts / sessions). Generate a random
# secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-32+-character-secret

# The app's own base URL — Better Auth uses this to build auth endpoint URLs.
BETTER_AUTH_URL=http://localhost:3001
