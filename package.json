{
  "name": "airline-booking-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"node --watch server/index.js\"",
    "build": "vite build",
    "start": "node server/index.js",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "auth:migrate": "auth migrate --config server/auth.js -y",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run auth:migrate",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-auth": "^1.7.12",
    "dotenv": "^18.0.8",
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "auth": "^1.7.12",
    "concurrently": "^9.1.2",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
